{
  "name": "putting-ai-code-to-the-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/browser-test.mjs",
    "test:mutation": "stryker run",
    "mutation:inspect": "node scripts/inspect-mutations.mjs",
    "acceptance:verify": "node scripts/acceptance.mjs verify",
    "acceptance:approve": "node scripts/acceptance.mjs approve",
    "scene": "node scripts/scene.mjs",
    "rehearse": "node scripts/rehearse.mjs",
    "release": "node scripts/release.mjs",
    "review:bundle": "node scripts/review-bundle.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.0.18",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
